<Window x:Class="MQCtrl.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MQTT 配置" Width="560" Height="590" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="-1,-1,-1,0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid Margin="20,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="M 3,28 L 7,7 Q 7.5,4 10,4 L 14,4 L 20,17 L 26,4 L 30,4 Q 32.5,4 33,7 L 37,28 L 30,28 L 28,15 L 22,27 L 18,27 L 12,15 L 10,28 Z" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <TextBlock Text="MQCtrl" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="14,0"/>
                        <TextBlock Text="MQTT 配置" Foreground="{DynamicResource SecondaryText}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource TitleBarButton}" ToolTip="关闭" Click="CloseDialog_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.4" Width="14" Height="14" Stretch="None"/>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="连接配置" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="MQTT 3.1.1/TCP 通用模式适用于 Mosquitto、Home Assistant MQTT、EMQX、HiveMQ 等。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="平台" VerticalAlignment="Center"/><ComboBox x:Name="PlatformBox" Grid.Column="1" Height="32" SelectedIndex="0"><ComboBoxItem Content="巴法云"/><ComboBoxItem Content="通用 MQTT（常见兼容平台）"/></ComboBox>
                    <TextBlock Grid.Row="1" Text="服务器地址" VerticalAlignment="Center"/><TextBox x:Name="HostBox" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="端口" VerticalAlignment="Center"/><TextBox x:Name="PortBox" Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="客户端 ID / 私钥" VerticalAlignment="Center"/><TextBox x:Name="ClientIdBox" Grid.Row="3" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="4" Text="用户名（可选）" VerticalAlignment="Center"/><TextBox x:Name="UsernameBox" Grid.Row="4" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="5" Text="密码（可选）" VerticalAlignment="Center"/><PasswordBox x:Name="PasswordBox" Grid.Row="5" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0">
                        <CheckBox x:Name="TlsBox" Content="使用 TLS 加密（巴法云端口 9503）" Checked="TlsBox_Changed" Unchecked="TlsBox_Changed"/>
                        <TextBlock Text="保存后自动重连。配置优先保存在程序目录；若目录不可写，则保存在用户本地 AppData\MQCtrl。" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="取消" Width="88" Margin="0,0,10,0" IsCancel="True"/>
                    <Button Content="保存并连接" Width="120" Background="{DynamicResource AccentBrush}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
