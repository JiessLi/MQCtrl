<Window x:Class="MQCtrl.FeatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="指令配置" Width="600" Height="570" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" WindowStyle="None" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="-1,-1,-1,0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid Margin="20,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="M 3,28 L 7,7 Q 7.5,4 10,4 L 14,4 L 20,17 L 26,4 L 30,4 Q 32.5,4 33,7 L 37,28 L 30,28 L 28,15 L 22,27 L 18,27 L 12,15 L 10,28 Z" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="2"/>
                        </Border>
                        <TextBlock Text="MQCtrl" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="14,0"/>
                        <TextBlock Text="指令管理" Foreground="{DynamicResource SecondaryText}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource TitleBarButton}" ToolTip="关闭" Click="CloseDialog_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.4" Width="14" Height="14" Stretch="None"/>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="24,20,24,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="添加指令" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="收到主题消息且内容完全匹配时，执行对应操作。" Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,18"/>
                </StackPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="50"/><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="功能名称" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="MQTT 主题" VerticalAlignment="Center"/><TextBox x:Name="TopicBox" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="匹配消息" VerticalAlignment="Center"/><TextBox x:Name="MatchBox" Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="执行动作" VerticalAlignment="Center"/><ComboBox x:Name="ActionBox" Grid.Row="3" Grid.Column="1" Height="32" VerticalContentAlignment="Center" SelectionChanged="ActionBox_SelectionChanged"><ComboBoxItem Content="关闭电脑" Tag="shutdown"/><ComboBoxItem Content="重新启动" Tag="restart"/><ComboBoxItem Content="锁定 Windows 会话" Tag="lock"/><ComboBoxItem Content="运行自定义脚本" Tag="script"/></ComboBox>
                    <TextBlock Grid.Row="4" Text="脚本文件" VerticalAlignment="Center"/><Grid x:Name="ScriptPanel" Grid.Row="4" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ScriptBox" Height="32" VerticalContentAlignment="Center"/><Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Click="Browse_Click"/></Grid>
                    <CheckBox x:Name="EnabledBox" Grid.Row="5" Grid.Column="1" Content="启用此指令" VerticalAlignment="Top" Margin="0,12,0,0"/>
                </Grid>
                <DockPanel Grid.Row="2" Margin="0,14,0,0">
                    <Button x:Name="DeleteButton" Content="删除" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Visibility="Collapsed" Click="Delete_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Width="88" Margin="0,0,10,0" IsCancel="True"/><Button Content="保存" Width="100" Background="{DynamicResource AccentBrush}" Click="Save_Click"/></StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
