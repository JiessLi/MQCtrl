<Window x:Class="MQCtrl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MQCtrl"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MQCtrl" Icon="{StaticResource MqCtrlLogo}" Width="1180" Height="680" MinWidth="1000" MinHeight="620" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource PrimaryText}" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
    <Grid Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="-1,-1,-1,0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <Grid Margin="24,0,10,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/><ColumnDefinition Width="1"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Margin="0,0,12,0">
                    <Image Source="{StaticResource MqCtrlLogo}" Stretch="Uniform"/>
                </Border>
                <TextBlock Text="MQCtrl" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Ellipse x:Name="HeaderDot" Width="10" Height="10" Fill="{DynamicResource SecondaryText}" Margin="24,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="HeaderStatus" Text="待配置" Foreground="{DynamicResource SecondaryText}" FontSize="15" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="12,6" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PlatformBadge" Text="巴法云" Foreground="{DynamicResource SecondaryText}"/>
                </Border>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource TitleGearButton}" Content="⚙" FontSize="18" ToolTip="编辑配置" Click="EditMqtt_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Border Grid.Column="2" Width="1" Height="28" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Style="{StaticResource TitleBarButton}" ToolTip="最小化" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M 2,8 H 12" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.4" Width="14" Height="10" Stretch="None"/></Button>
            <Button Grid.Column="4" Style="{StaticResource TitleBarButton}" ToolTip="最大化 / 还原" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M 2,2 H 12 V 12 H 2 Z" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.2" Width="14" Height="14" Stretch="None"/></Button>
            <Button Grid.Column="5" Style="{StaticResource TitleBarButton}" ToolTip="关闭到托盘" Click="CloseToTray_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Data="M 2,2 L 12,12 M 12,2 L 2,12" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.4" Width="14" Height="14" Stretch="None"/></Button>
        </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2.05*"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="▰" Foreground="{DynamicResource AccentBrush}" FontSize="25" Margin="4,0,16,0"/><StackPanel><TextBlock Text="指令映射" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="收到匹配消息后，执行对应的电脑操作" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/></StackPanel></StackPanel><Button Content="＋  添加指令" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddFeature_Click"/></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Features}"><ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2,3" MinHeight="70">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width=".9*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                                <Border Width="42" Height="42" CornerRadius="4" Background="Transparent" VerticalAlignment="Center"><Image Source="{Binding IconImage}" Width="36" Height="36" Stretch="Uniform"/></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ActionLabel}" Foreground="{DynamicResource SecondaryText}" FontSize="13" Margin="0,3,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0"><TextBlock Text="匹配值" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><Border Background="{DynamicResource FieldBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,3,0,0"><TextBlock Text="{Binding MatchValue}" FontSize="14"/></Border></StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center"><ToggleButton IsChecked="{Binding Enabled, Mode=TwoWay}" Width="48" Height="26" Checked="FeatureEnabled_Changed" Unchecked="FeatureEnabled_Changed" Tag="{Binding}"/><TextBlock Text="{Binding EnabledLabel}" Foreground="{DynamicResource SecondaryText}" FontSize="13" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
                                <Button Grid.Column="4" Content="⋮" FontSize="20" Padding="0" Width="32" Height="32" VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent" Tag="{Binding}" Click="EditFeature_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0" Margin="8,0,0,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel LastChildFill="False" VerticalAlignment="Center"><Button Content="清空日志" DockPanel.Dock="Right" Padding="8,4" FontSize="13" MinWidth="80" HorizontalAlignment="Right" Click="ClearLog_Click"/><TextBlock Text="▤" Foreground="{DynamicResource SecondaryText}" FontSize="21" Margin="0,0,14,0"/><TextBlock Text="实时日志" FontWeight="SemiBold" FontSize="20"/></DockPanel></Border>
                    <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemsSource="{Binding LogItems}" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type local:LogDateHeader}"><Border Margin="12,10,8,4" Padding="4,0,0,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding DateLabel}" Foreground="{DynamicResource SecondaryText}" FontSize="12" FontWeight="SemiBold"/></Border></DataTemplate>
                            <DataTemplate DataType="{x:Type local:LogEntry}"><Grid Margin="10,6,8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="72"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Ellipse Grid.Row="0" Grid.Column="0" Width="9" Height="9" Fill="{Binding DotBrush}" VerticalAlignment="Top" Margin="0,6,0,0"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontWeight="SemiBold" FontSize="15" Margin="8,0"/><TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Time}" Foreground="{DynamicResource SecondaryText}" Opacity="0.62" FontSize="12" MinWidth="64" HorizontalAlignment="Stretch" TextAlignment="Right" VerticalAlignment="Top" TextWrapping="NoWrap"/><TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" FontSize="14" Margin="8,4,0,0"/></Grid></DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="-1,0,-1,-1" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="30,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="30" Height="30" Margin="-7,0,19,0">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Rectangle Fill="{DynamicResource AccentBrush}" Margin="1,1,2,2"/><Rectangle Grid.Column="1" Fill="{DynamicResource AccentBrush}" Margin="2,1,1,2"/>
                    <Rectangle Grid.Row="1" Fill="{DynamicResource AccentBrush}" Margin="1,2,2,1"/><Rectangle Grid.Row="1" Grid.Column="1" Fill="{DynamicResource AccentBrush}" Margin="2,2,1,1"/>
                </Grid>
                <TextBlock Text="开机自启动" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                <ToggleButton x:Name="StartupToggle" Style="{StaticResource StartupToggleStyle}" Width="50" Height="26" Margin="18,0,12,0" VerticalAlignment="Center" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"/>
                <TextBlock x:Name="StartupLabel" Text="已关闭" Foreground="{DynamicResource SecondaryText}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                <Border Width="1" Height="25" Background="{DynamicResource BorderBrush}" Margin="22,0"/>
                <TextBlock Text="随系统启动，持续监听 MQTT 消息" Foreground="{DynamicResource SecondaryText}" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>
                <TextBlock Grid.Column="1" x:Name="UpdateStatusText" Text="v-- | 检查中" Foreground="{DynamicResource SecondaryText}" FontSize="13" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="UpdateStatus_Click" ToolTip="点击检查更新或应用已下载的更新"/>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
